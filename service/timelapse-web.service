[Unit]
Description=Read-only web UI for timelapse-maker
Documentation=https://github.com/war4peace/timelapse-maker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Must match the user that owns the frames and videos, so it can read them.
User=timelapse
Group=timelapse
ExecStart=/usr/bin/python3 /opt/timelapse/timelapse_web.py /etc/timelapse/config.json
# on-failure, not always: the program exits 0 when web.enabled is false, and
# that is a decision to respect rather than a crash to restart through.
Restart=on-failure
RestartSec=15
# Serving a page must never cost the capture daemon a frame.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Hardening. This service is read-only by design - it never writes anything,
# anywhere - so unlike the other two units it deliberately has NO
# ReadWritePaths and the entire filesystem stays read-only to it. If you ever
# give it something to write, add the path here AND to install.sh sync_units().
#
# Reading still works everywhere ProtectSystem=strict only remounts read-only,
# including a NAS mount under /mnt.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX is not optional: systemctl reaches PID 1 over a unix socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The status pane runs `journalctl -u ...`, which returns "-- No entries --"
# for a user outside this group rather than a permission error - i.e. it looks
# like a bug in the UI. This grants read access without putting the account in
# the group system-wide.
#
# install.sh sync_units() DELETES this line when the group does not exist,
# because a SupplementaryGroups naming a missing group stops the unit from
# starting at all. Every systemd distro has it; the guard is for the ones the
# installer has never been run on.
SupplementaryGroups=systemd-journal

[Install]
WantedBy=multi-user.target
