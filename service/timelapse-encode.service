[Unit]
Description=Encode yesterday's timelapse frames into daily videos
Documentation=https://github.com/war4peace/timelapse-maker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Must match the user that owns the frames written by timelapse-capture.
User=timelapse
Group=timelapse
ExecStart=/usr/bin/python3 /opt/timelapse/timelapse_encode.py /etc/timelapse/config.json
# A full backlog catch-up can legitimately take hours; do not let systemd
# kill it mid-encode.
TimeoutStartSec=infinity
# Encoding is a batch job. Yield to capture, which must not miss frames.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Hardening. ReadWritePaths must list every path this writes to, including
# a local transfer destination (e.g. a CIFS/NFS mountpoint) if you use one.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# No PrivateDevices here, deliberately: it hides /dev/nvidia*, and an encode
# that cannot see the GPU falls back to libx264 and succeeds, taking hours
# instead of minutes, with nothing to say why.
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX is not optional: it is how a child reaches systemd, journald and
# the resolver. The three together are what this program can possibly need,
# and everything else (netlink route dumps, packet sockets, bluetooth) is
# refused. Verified on real systemd, because a missing family here presents
# as a name that will not resolve rather than as an error about sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/timelapse

# No [Install] section. This is started by timelapse-encode.timer and by nothing
# else, and `systemctl enable` on a timer-fired oneshot means "also run it at
# every boot", which for the encode is a full backlog pass at the worst
# possible moment. Enable the timer instead; the installer does.
