[Unit]
Description=Report cameras that are refusing our credentials
Documentation=https://github.com/war4peace/timelapse-maker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Same account as capture and encode: it reads the state file the capture
# daemon writes, and the config that holds the notification sinks.
User=timelapse
Group=timelapse
ExecStart=/usr/bin/python3 /opt/timelapse/timelapse_encode.py --watch /etc/timelapse/config.json
# It reads one small file and may send one notification. If that cannot be
# done in a minute it is not going to be done at all, and the next timer tick
# is only a few minutes away.
TimeoutStartSec=60
Nice=10

# Hardening. This writes exactly one file, notified.json, in the state
# directory: which incidents have already been reported, so a camera that has
# been refusing all day is not announced every few minutes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX is not optional: it is how a child reaches systemd, journald and
# the resolver. The three together are what this program can possibly need,
# and everything else (netlink route dumps, packet sockets, bluetooth) is
# refused. Verified on real systemd, because a missing family here presents
# as a name that will not resolve rather than as an error about sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/timelapse

# No [Install] section. This is started by timelapse-watch.timer and by nothing
# else, and `systemctl enable` on a timer-fired oneshot means "also run it at
# every boot", which for the encode is a full backlog pass at the worst
# possible moment. Enable the timer instead; the installer does.
