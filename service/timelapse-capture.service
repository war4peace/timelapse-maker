[Unit]
Description=Camera snapshot capture for timelapse
Documentation=https://github.com/war4peace/timelapse-maker
After=network-online.target
Wants=network-online.target
# A board with no real-time clock boots near the epoch and is stepped by NTP a
# minute later; a frame captured before then lands in a 1970 day directory the
# encoder skips for ever. This waits for the clock where the distribution
# provides a service that holds time-sync.target back, and costs nothing where
# it does not. The daemon also resyncs on a step it sees (tick_plan).
After=time-sync.target
Wants=time-sync.target

[Service]
Type=simple
# Change User/Group to the account that owns the frames directory.
User=timelapse
Group=timelapse
ExecStart=/usr/bin/python3 /opt/timelapse/timelapse_capture.py /etc/timelapse/config.json
Restart=always
RestartSec=15
# Cameras are the slow part, not CPU; keep this off the encoder's back.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# Hardening. ReadWritePaths must list every path the daemon writes to -
# if you move paths.frames_root or paths.log_dir in config.json, change it
# here too or writes fail with a confusing read-only error.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX is not optional: it is how a child reaches systemd, journald and
# the resolver. The three together are what this program can possibly need,
# and everything else (netlink route dumps, packet sockets, bluetooth) is
# refused. Verified on real systemd, because a missing family here presents
# as a name that will not resolve rather than as an error about sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/timelapse

[Install]
WantedBy=multi-user.target
